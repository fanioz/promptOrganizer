<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Accent Brushes -->
  <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E"/>
  <SolidColorBrush x:Key="AccentYellowBrush" Color="#FACC15"/>
  <SolidColorBrush x:Key="AccentPinkBrush" Color="#EC4899"/>
  <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444"/>
  <SolidColorBrush x:Key="AccentVioletBrush" Color="#8B5CF6"/>
  
  <!-- Column Backgrounds -->
  <SolidColorBrush x:Key="ColumnBackgroundSageBrush" Color="#E8F3E8"/> <!-- Sage Green -->
  <SolidColorBrush x:Key="ColumnBackgroundBeigeBrush" Color="#FDF6E3"/> <!-- Warm Beige -->
  <SolidColorBrush x:Key="ColumnBackgroundBlueBrush" Color="#E6F2F5"/> <!-- Dusty Blue -->
  
  <!-- Effects -->
  <SolidColorBrush x:Key="RippleColorBrush" Color="#20000000"/>

  <!-- Spacing Scale (px) -->
  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
  <x:Double x:Key="Spacing24">24</x:Double>
  <x:Double x:Key="Spacing32">32</x:Double>
  <x:Double x:Key="Spacing40">40</x:Double>
  <x:Double x:Key="Spacing56">56</x:Double>

  <!-- Corner Radii -->
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ChipCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="ModalCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="ColumnHeaderCornerRadius">8</CornerRadius>

  <!-- Typography -->
  <FontFamily x:Key="UIFontFamily">Segoe UI, Inter, Arial</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Menlo</FontFamily>

  <x:Double x:Key="FontSize12">12</x:Double>
  <x:Double x:Key="FontSize14">14</x:Double>
  <x:Double x:Key="FontSize16">16</x:Double>
  <x:Double x:Key="FontSize18">18</x:Double>
  <x:Double x:Key="FontSize20">20</x:Double>
  <x:Double x:Key="FontSize24">24</x:Double>
  <x:Double x:Key="FontSize32">32</x:Double>

  <!-- Elevation tokens (for reference) -->
  <x:Double x:Key="Elevation1Opacity">0.08</x:Double>
  <x:Double x:Key="Elevation2Opacity">0.10</x:Double>

</ResourceDictionary>
