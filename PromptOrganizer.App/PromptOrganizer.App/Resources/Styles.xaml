<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource PrimaryButtonBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource PrimaryButtonForegroundBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSize14}"/>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SecondaryButtonBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource SecondaryButtonForegroundBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSize14}"/>
  </Style>

  <Style x:Key="TopBarTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSize20}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
  </Style>

  <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSize14}"/>
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Width" Value="360"/>
  </Style>

</ResourceDictionary>
