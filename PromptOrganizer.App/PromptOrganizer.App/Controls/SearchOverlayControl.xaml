<UserControl
    x:Class="PromptOrganizer.App.Controls.SearchOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Visibility="Collapsed" Background="Transparent">
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="#66000000"/>
            </Grid.Background>
        </Grid>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="720">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OverlayScale" ScaleX="0.98" ScaleY="0.98"/>
            </Grid.RenderTransform>
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBox x:Name="QueryBox" 
                             PlaceholderText="Search prompts…" 
                             MinHeight="48"
                             TextChanged="QueryBox_TextChanged"/>
                    <ListView x:Name="ResultsList" 
                              MinHeight="200"
                              IsItemClickEnabled="True"
                              ItemClick="ResultsList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Padding="0,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Content}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               MaxLines="2" 
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Closed"/>
                <VisualState x:Name="Open">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="OverlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/>
                        <DoubleAnimation Storyboard.TargetName="OverlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
