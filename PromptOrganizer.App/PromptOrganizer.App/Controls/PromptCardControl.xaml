<UserControl
    x:Class="PromptOrganizer.App.Controls.PromptCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PromptOrganizer.App.Controls">
    <Grid Margin="0,0,0,0" Loaded="OnLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{x:Bind LabelBrush, Mode=OneWay}"/>
        <Border Grid.Column="1"
                x:Name="CardBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Opacity="0"
                PointerEntered="CardBorder_PointerEntered"
                PointerExited="CardBorder_PointerExited"
                PointerPressed="CardBorder_PointerPressed"
                PointerReleased="CardBorder_PointerReleased">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Padding="16" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind Icon, Mode=OneWay}"
                               FontSize="20"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Title, Mode=OneWay}"
                               FontFamily="{StaticResource UIFontFamily}"
                               FontSize="{StaticResource FontSize16}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Opacity="0.6">
                            <TextBlock Text="v" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind VersionCount, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="FavoriteButton" 
                                MinWidth="28" 
                                MinHeight="28" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                ToolTipService.ToolTip="Favorite" 
                                Click="FavoriteButton_Click"
                                Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <SymbolIcon Symbol="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToFavoriteIconConverter}}"/>
                        </Button>
                        <Button x:Name="HistoryButton" MinWidth="28" MinHeight="28" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="History" Click="HistoryButton_Click">
                            <SymbolIcon Symbol="Clock"/>
                        </Button>
                        <Button x:Name="CopyButton" MinWidth="28" MinHeight="28" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Copy" Click="CopyButton_Click">
                            <SymbolIcon Symbol="Copy"/>
                        </Button>
                        <Button x:Name="EditButton" MinWidth="28" MinHeight="28" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Edit" Click="EditButton_Click">
                            <SymbolIcon Symbol="Edit"/>
                        </Button>
                        <Button x:Name="DeleteButton" MinWidth="28" MinHeight="28" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Delete" Click="DeleteButton_Click">
                            <SymbolIcon Symbol="Delete"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" Margin="16,0,16,0" ItemsSource="{x:Bind VisibleTags, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <controls:TagChipControl Text="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:TagChipControl x:Name="OverflowChip" Grid.Row="1" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="2" Margin="16,8,16,16"
                           Text="{x:Bind BodyPreview, Mode=OneWay}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="WrapWholeWords"
                           TextTrimming="CharacterEllipsis"/>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Target="FavoriteButton.Opacity" Value="0"/>
                                <Setter Target="CopyButton.Opacity" Value="0"/>
                                <Setter Target="EditButton.Opacity" Value="0"/>
                                <Setter Target="CardBorder.Background" Value="{ThemeResource SurfaceBrush}"/>
                                <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource BorderBrush}"/>
                                <Setter Target="CardBorder.BorderThickness" Value="1"/>
                            </VisualState.Setters>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FavoriteButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CopyButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="EditButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08"/>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08"/>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="FavoriteButton.Opacity" Value="1"/>
                                <Setter Target="CopyButton.Opacity" Value="1"/>
                                <Setter Target="EditButton.Opacity" Value="1"/>
                                <Setter Target="CardBorder.Background" Value="{ThemeResource SurfaceAltBrush}"/>
                                <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource BorderBrush}"/>
                                <Setter Target="CardBorder.BorderThickness" Value="1"/>
                            </VisualState.Setters>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FavoriteButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CopyButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="EditButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource FocusBrush}"/>
                                <Setter Target="CardBorder.BorderThickness" Value="2"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy" Click="CopyButton_Click"/>
                    <MenuFlyoutItem Text="Edit" Click="EditButton_Click"/>
                    <MenuFlyoutItem Text="Favorite" Click="FavoriteButton_Click"/>
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>
    </Grid>
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnOpenInvoked"/>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyInvoked"/>
        <KeyboardAccelerator Key="F" Invoked="OnFavoriteInvoked"/>
    </UserControl.KeyboardAccelerators>
</UserControl>
