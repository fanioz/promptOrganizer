<UserControl
    x:Class="PromptOrganizer.App.Controls.TagChipControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptOrganizer.App.Controls">
    <Border
        Background="{ThemeResource ChipBackgroundBrush}"
        CornerRadius="{StaticResource ChipCornerRadius}"
        Padding="6,0"
        MinHeight="28">
        <TextBlock
            Text="{x:Bind Text, Mode=OneWay}"
            VerticalAlignment="Center"
            Margin="10,0"
            Foreground="{ThemeResource ChipTextBrush}"
            FontFamily="{StaticResource UIFontFamily}"
            FontSize="{StaticResource FontSize14}"/>
    </Border>
</UserControl>
