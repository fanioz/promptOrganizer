<UserControl
    x:Class="PromptOrganizer.App.Controls.PromptEditorModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root"
            Visibility="Collapsed"
            Background="Transparent">
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="#44000000"/>
            </Grid.Background>
        </Grid>
        <Grid HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="960">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ModalScale"
                        ScaleX="0.98"
                        ScaleY="0.98"/>
            </Grid.RenderTransform>
            <Border Background="{ThemeResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="24"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBox x:Name="TitleTextBox"
                            PlaceholderText="Title"/>
                    <TextBox x:Name="CategoryTextBox"
                            PlaceholderText="Category"/>
                    <TextBox x:Name="TagsTextBox"
                            PlaceholderText="Tags (comma separated)"/>
                    <TextBox x:Name="BodyTextBox"
                            PlaceholderText="Prompt body (Markdown)"
                            AcceptsReturn="True"
                            MinHeight="200"/>
                    <StackPanel Orientation="Horizontal"
                            Spacing="12">
                        <Button Content="Save"
                                Click="Save_Click"/>
                        <Button Content="Copy"/>
                        <Button Content="Export"/>
                        <Button Content="Close"
                                Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Closed"/>
                <VisualState x:Name="Open">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ModalScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="0:0:0.25"/>
                        <DoubleAnimation Storyboard.TargetName="ModalScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.25"/>
                        <DoubleAnimation Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.22"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
