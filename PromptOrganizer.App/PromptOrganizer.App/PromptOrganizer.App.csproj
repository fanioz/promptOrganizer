<Project Sdk="Uno.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\PromptOrganizer.Services\PromptOrganizer.Services.csproj" />
    <ProjectReference Include="..\..\PromptOrganizer.Domain\PromptOrganizer.Domain.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>PromptOrganizer.App</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.promptorganizer-app</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>PromptOrganizer.App</ApplicationPublisher>
    <!-- Package Description -->
    <Description>PromptOrganizer.App powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
