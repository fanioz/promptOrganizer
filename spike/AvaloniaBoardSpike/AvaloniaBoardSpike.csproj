<Project Sdk="Microsoft.NET.Sdk">

  <!-- PROTOTYPE (wayfinder ticket #4): throwaway Avalonia spike of the board screen.
       Not referenced by PromptOrganizer.sln. Answers: can Avalonia faithfully render the
       PromptOrganizer design system, and at what authoring cost vs Uno? -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.*" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
