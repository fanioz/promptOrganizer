<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- PROTOTYPE: tokens mirrored from PromptOrganizer.App/Resources (Theme/Light.xaml, Dark.xaml, DesignTokens.xaml). -->

  <!-- Theme-independent accents (spec: accents unchanged across modes) -->
  <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E" />
  <SolidColorBrush x:Key="AccentYellowBrush" Color="#FACC15" />
  <SolidColorBrush x:Key="AccentPinkBrush" Color="#EC4899" />
  <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444" />
  <SolidColorBrush x:Key="AccentVioletBrush" Color="#8B5CF6" />

  <!-- Typography -->
  <FontFamily x:Key="UIFontFamily">Segoe UI, Inter, Arial</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Menlo</FontFamily>

  <!-- Corner radii -->
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ChipCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="ModalCornerRadius">12</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BackgroundBrush" Color="#F7F7F8" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFAFB" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
      <SolidColorBrush x:Key="BorderBrush" Color="#EDEEF0" />
      <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#EDEEF0" />
      <SolidColorBrush x:Key="ChipTextBrush" Color="#4B5563" />
      <SolidColorBrush x:Key="FocusBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#EDEEF0" />
      <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#1F2937" />
      <!-- Column tints (as in the current Uno build) -->
      <SolidColorBrush x:Key="ColumnSageBrush" Color="#E8F3E8" />
      <SolidColorBrush x:Key="ColumnBeigeBrush" Color="#FDF6E3" />
      <SolidColorBrush x:Key="ColumnBlueBrush" Color="#E6F2F5" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BackgroundBrush" Color="#111316" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#16181C" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1D2026" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E5E7EB" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2E3440" />
      <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#242832" />
      <SolidColorBrush x:Key="ChipTextBrush" Color="#E5E7EB" />
      <SolidColorBrush x:Key="FocusBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#242832" />
      <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#E5E7EB" />
      <!-- Derived dark tints: the current Uno build has NO dark variants for these
           (its pastel column backgrounds glare in dark mode) — a fidelity gap the
           Avalonia theme dictionaries close for free. -->
      <SolidColorBrush x:Key="ColumnSageBrush" Color="#1C2B20" />
      <SolidColorBrush x:Key="ColumnBeigeBrush" Color="#2A251A" />
      <SolidColorBrush x:Key="ColumnBlueBrush" Color="#17262C" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
